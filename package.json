{
  "name": "loop-and-learn",
  "version": "2.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "build:standalone": "vite build --config vite.standalone.config.js",
    "start": "node --env-file-if-exists=.env server.mjs",
    "build:pages": "npm run build:standalone && node scripts/build-pages.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "prettier": "^3.10.1",
    "vite": "^6.1.0",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
